# Django Configuration
DEBUG=False
SECRET_KEY=your-secure-secret-key-here-change-this

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/database_name
DB_NAME=tienda_db
DB_USER=tienda_user
DB_PASSWORD=your-secure-password
DB_HOST=your-render-db-host
DB_PORT=5432

# Allowed Hosts
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-app-name.onrender.com,http://localhost:3000,http://localhost:3001

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
